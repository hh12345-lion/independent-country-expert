NEXT_PUBLIC_SITE_URL=https://www.independentcountryexpert.com

# Lead webhook (n8n) — Lead_notification_setup.md
# Set in Netlify → Environment variables and in .env for `netlify dev`.
# On submit, Netlify function POSTs: Full Name, Email, Phone Number, Brand name
# LEAD_NOTIFICATION_URL is accepted as a fallback.
Lead_notification_url=
# LEAD_NOTIFICATION_URL=

# Google Sheets (contact form → spreadsheet) — never commit real credentials
# See Google_sheets_setup.md. Share the sheet with the service account as Editor.
# Private key: keep literal \n inside double quotes (runtime converts to newlines).
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-writer@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_TAB_NAME=Sheet1
# Optional (Docker / self-hosted): path to service-account JSON instead of email+key
# GOOGLE_KEY_FILE_PATH=/secrets/service-account.json

# Analytics & marketing (loaded only after cookie consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_HOTJAR_ID=

# Site verification
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
